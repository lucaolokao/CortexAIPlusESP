# Copie este arquivo para .env e preencha os valores

# ─── Banco de Dados ───────────────────────────────────────
# Neon (gratuito): https://neon.tech → copie a connection string
DATABASE_URL="postgresql://user:senha@host/dbname?sslmode=require"

# ─── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Segurança ────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="seu-jwt-secret-super-secreto-aqui"

# ─── CORS ─────────────────────────────────────────────────
# URL do seu dashboard na Vercel (sem barra final)
FRONTEND_URL="https://cortexai.vercel.app"
